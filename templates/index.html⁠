<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset='UTF-8'>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>VibeMate - Lombardia</title>
    <style>
        * { box-sizing: border-box; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
        body { background: #0f0f13; color: white; display: flex; justify-content: center; align-items: center; min-height: 100vh; margin: 0; padding: 15px; }
        .box { background: #1a1a24; padding: 25px; border-radius: 20px; width: 100%; max-width: 350px; display: flex; flex-direction: column; gap: 12px; border: 1px solid #2a2a38; }
        h2 { margin: 0 0 10px; color: #ff4757; text-align: center; }
        input, select, textarea, button { width: 100%; padding: 12px; border-radius: 10px; border: 1px solid #333; background: #0f0f13; color: white; font-size: 14px; }
        textarea { resize: vertical; height: 80px; }
        button { background: #ff4757; font-weight: bold; cursor: pointer; border: none; margin-top: 5px; }
        a { color: #ff4757; text-decoration: none; text-align: center; display: block; margin-top: 10px; font-size: 13px; }
        
        /* Stili Swipe Home */
        header { width: 100%; max-width: 400px; position: absolute; top: 15px; padding: 15px; display: flex; justify-content: space-between; align-items: center; }
        .logo { font-weight: bold; font-size: 20px; color: #ff4757; }
        .user-tag { font-size: 13px; color: #aaa; }
        .main-container { width: 100%; max-width: 400px; height: 580px; position: relative; padding: 20px; display: flex; justify-content: center; align-items: center; }
        .card { width: 100%; height: 100%; background: #1a1a24; border-radius: 20px; overflow: hidden; display: flex; flex-direction: column; border: 1px solid #2a2a38; position: absolute; }
        .card-img { width: 100%; height: 70%; background-size: cover; background-position: center; background-color: #222; }
        .card-info { padding: 15px; flex-grow: 1; display: flex; flex-direction: column; gap: 5px; }
        .card-info h2 { margin: 0; font-size: 22px; text-align: left; color: white; }
        .badge { display: inline-block; background: rgba(255,71,87,0.2); color: #ff4757; border: 1px solid rgba(255,71,87,0.4); font-size: 12px; padding: 3px 8px; border-radius: 6px; width: fit-content; }
        .card-info p { margin: 0; color: #aaa; font-size: 14px; line-height: 1.4; }
        .actions { display: flex; justify-content: space-around; padding: 15px; background: #14141c; }
        .btn { width: 55px; height: 55px; border-radius: 50%; border: none; font-size: 22px; cursor: pointer; display: flex; align-items: center; justify-content: center; }
        .dislike { background: #2a2a38; color: #ff4757; }
        .like { background: #ff4757; color: white; box-shadow: 0 4px 15px rgba(255,71,87,0.4); }
        .btn:active { transform: scale(0.9); }
        nav.bottom-bar { width: 100%; max-width: 400px; position: absolute; bottom: 0; background: #1a1a24; border-top: 1px solid #2a2a38; display: flex; }
        nav.bottom-bar a { color: #888; text-decoration: none; font-size: 14px; font-weight: bold; text-align: center; flex: 1; padding: 15px 0; margin: 0; }
        nav.bottom-bar a.active { color: #ff4757; }
        .no-profiles { text-align: center; color: #888; font-size: 16px; padding: 40px; }
    </style>
</head>
<body>

    {% if is_login %}
    <form class='box' method='POST'>
        <h2>VibeMate 🔥</h2>
        <input type='email' name='email' placeholder='Email' required>
        <input type='password' name='password' placeholder='Password' required>
        <button type='submit'>Accedi</button>
        <a href='/register'>Non hai un account? Registrati</a>
    </form>

    {% elif is_register %}
    <form class='box' method='POST'>
        <h2>VibeMate Lombardia 🔥</h2>
        <input type='email' name='email' placeholder='Email' required>
        <input type='password' name='password' placeholder='Password' required>
        <input type='text' name='nome' placeholder='Nome' required>
        <input type='number' name='eta' placeholder='Età' required>
        <select name='provincia' required>
            <option value='' disabled selected>Seleziona Provincia (Lombardia)</option>
            {% for prov in provincie %}
                <option value='{{ prov }}'>{{ prov }}</option>
            {% endfor %}
        </select>
        <textarea name='bio' placeholder='La tua biografia'></textarea>
        <input type='text' name='foto' placeholder='Link URL foto profilo (opzionale)'>
        <button type='submit'>Crea Account</button>
        <a href='/login'>Hai già un account? Accedi</a>
    </form>

    {% else %}
    <header>
        <div class="logo">VibeMate 🔥</div>
        <div class="user-tag">📍 {{ session.get('user_provincia') }} | {{ session.get('user_nome') }}</div>
    </header>

    <div class="main-container">
        <div class="card" id="card">
            <div class="card-img" id="img"></div>
            <div class="card-info">
                <h2 id="name"></h2>
                <span class="badge" id="provincia"></span>
                <p id="bio"></p>
            </div>
            <div class="actions">
                <button class="btn dislike" onclick="swipe('dislike')">✕</button>
                <button class="btn like" onclick="swipe('like')">❤</button>
            </div>
        </div>
        <div id="no-more" class="no-profiles" style="display:none;">
            <h3>Nessun altro profilo in zona</h3>
            <p>Torna più tardi per scoprire nuovi profili in Lombardia.</p>
        </div>
    </div>

    <nav class="bottom-bar">
        <a href="/" class="active">🔥 Swipe</a>
        <a href="/matches">💬 Chat & Match</a>
        <a href="/logout">🚪 Esci</a>
    </nav>

    <script>
        let profiles = {{ profili | tojson }};
        let index = 0;

        function renderCard() {
            if (!profiles || index >= profiles.length) {
                document.getElementById('card').style.display = 'none';
                document.getElementById('no-more').style.display = 'block';
                return;
            }
            const p = profiles[index];
            document.getElementById('img').style.backgroundImage = `url('${p.foto || 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=500&q=60'}')`;
            document.getElementById('name').innerText = p.nome + ", " + p.eta;
            document.getElementById('provincia').innerText = p.provincia;
            document.getElementById('bio').innerText = p.bio || "Nessuna biografia.";
        }

        async function swipe(action) {
            if (index >= profiles.length) return;
            const targetId = profiles[index].id;

            const res = await fetch('/api/swipe', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ target_id: targetId, action: action })
            });
            const data = await res.json();

            if (data.match) {
                alert('🎉 UN MATCH! Vi siete messi Like a vicenda! Ora puoi scrivergli nella sezione Chat!');
            }

            index++;
            renderCard();
        }

        renderCard();
    </script>
    {% endif %}
</body>
</html>
