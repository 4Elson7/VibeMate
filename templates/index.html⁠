<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>VibeMate - Home</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: #0b0f19;
            color: #ffffff;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            overflow: hidden;
        }

        /* Header con Logo */
        .app-header {
            position: absolute;
            top: 20px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .app-logo {
            font-size: 1.5rem;
            font-weight: bold;
            background: linear-gradient(135deg, #ff2a85, #00f2fe);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            letter-spacing: 1px;
        }

        /* Container della Card Stile Tinder */
        .card-container {
            position: relative;
            width: 90%;
            max-width: 380px;
            height: 70vh;
            background: #151b2b;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .card-image {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        /* Info utente sfumate in basso sulla foto */
        .card-info {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            padding: 25px 20px;
            background: linear-gradient(to top, rgba(11, 15, 25, 0.95), transparent);
        }

        .card-info h2 {
            font-size: 1.8rem;
            margin-bottom: 5px;
        }

        .card-info p {
            font-size: 1rem;
            color: #a0aec0;
        }

        /* Bottoni d'azione */
        .action-buttons {
            display: flex;
            justify-content: center;
            gap: 30px;
            margin-top: 20px;
        }

        .btn {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            border: none;
            background: #151b2b;
            color: #ffffff;
            font-size: 1.4rem;
            cursor: pointer;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.3);
            border: 1px solid rgba(255, 255, 255, 0.1);
            transition: transform 0.2s, background 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .btn:hover {
            transform: scale(1.1);
        }

        .btn-dislike {
            color: #ff4757;
        }

        .btn-like {
            color: #2ed573;
        }
    </style>
</head>
<body>

    <!-- Logo in alto -->
    <div class="app-header">
        <div class="app-logo">⚡ VibeMate</div>
    </div>

    <!-- Card del profilo -->
    <div class="card-container">
        <!-- Esempio con dati dinamici che arriveranno dal database -->
        <img src="https://images.unsplash.com/photo-1543466835-00a7907e9de1?auto=format&fit=crop&w=800&q=80" alt="Foto profilo" class="card-image">
        
        <div class="card-info">
            <h2>Giulia, 24</h2>
            <p>📍 Varese</p>
        </div>
    </div>

    <!-- Pulsanti interattivi -->
    <div class="action-buttons">
        <button class="btn btn-dislike">✕</button>
        <button class="btn btn-like">♥</button>
    </div>

</body>
</html>
